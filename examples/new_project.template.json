      "embed_align.py": "87872ad0a3c1187773baa5275be382e7b6f3e73ff3a367fd3f14e03e4d2496c3",
      "grn_pcr.py": "d53b27daec632f0293e51d9e8a160aae3422ae6455d2446ea252a120bddab525",
      "io.py": "5b22831528f91a4e04db4376dc5bfda7bbf429b96041e085ce95d04441bb3e21",
      "ko.py": "693464401015634283922898724fd9ffb7cf659c0ec63a6ec510efbdb665d1f3",
      "preprocess.py": "bf6385bccc6227b3cee9f133466a0f105a2f3b91ea3a1cd2c0460fa538fdf4f9",
      "stability.py": "fc40cca1d7193453bf59974756141dd9360011c5640e319253039a5b143d37df",
      "tensor_denoise.py": "fcbbf092aa17a0354dd8873e7727005ce6ebbbdcb54cc1545a6f1986a54a50b3"
    },
    "dependency_paths": [],
    "params": {
      "n_subsample": 4,
      "subsample_frac": 0.8,
      "pca_k": 10,
      "ridge_alpha": 1.0,
      "cp_rank": 3,
      "embed_dim": 10,
      "beta": 0.2,
      "n_hops": 3,
      "n_runs": 3,
      "min_cells_frac": 0.02,
      "random_state": 271828,
      "n_top_genes": null
    },
    "official_commit": "5254bcfeece32442eee31590fe46bcc4af849181"
  },
  "donor_analysis": {
    "enabled": true,
    "min_cells": 15,
    "n_runs": 1
  },
  "programs": {},
