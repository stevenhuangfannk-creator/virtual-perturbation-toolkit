    "minimum_seed_spearman": 0.8,
    "min_donors": 3,
    "top_k": 30,
    "require_no_fixed_program_pooled_donor_conflicts": true,
    "history_informed": false,
    "scope": "Define and freeze suitable scientific criteria BEFORE running a new project. Empty programs make sign stability NOT_EVALUATED."
  },
  "runtime": {
    "python_monitor": "../local/env/Scripts/python.exe",
    "python_data": "../local/env/Scripts/python.exe",
    "Rscript": "../local/R/bin/Rscript.exe",
    "R_library": "../local/R/library"
  },
  "resources": {
    "threads": 2,
