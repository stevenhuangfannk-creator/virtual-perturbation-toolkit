{
  "schema_version": 1,
  "output_dir": "../outputs/new_project",
  "claim_scope": "exploratory_subset",
  "input": {
    "format": "h5ad",
    "path": "../local/processed_subset.h5ad",
    "counts_layer": "counts",
    "columns": {
      "cell_id": "cell_id",
      "sample_id": "sample_id",
      "donor_id": "donor_id",
      "state": "cell_state"
    },
    "species": "REPLACE_WITH_SPECIES",
    "accession": "REPLACE_WITH_DATA_SOURCE",
    "counts_origin": "REPLACE_WITH_EXPLICIT_RAW_COUNTS_SOURCE",
    "qc_status": "NOT_YET_AUDITED",
    "qc_completed": false,
    "annotation": {
      "kind": "operational",
      "label": "REPLACE_WITH_ORIGINAL_STATE_LABEL",
      "source": "REPLACE_WITH_ORIGINAL_STATE_DEFINITION"
    },
    "max_counts_bytes": 268435456
  },
  "features": {
    "mode": "variance",
    "n_genes": 450,
    "maximum_genes": 500,
    "maximum_cells": 5000
  },
  "targets": [
    "YOUR_GENE_SYMBOL"
  ],
  "perturbation": {
    "type": "KD",
